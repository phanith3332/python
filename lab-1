# Function name
def display_message():
    print("Function called successfully!")


# Class name
class Student:
    def __init__(self, name):
        self.name = name


# Variable
age = 20

# Constant-style name (Python convention: uppercase)
MAX_VALUE = 100

# Name using an underscore
student_id = 101

# Create an object of the class
s = Student("Sai")

# Print all identifiers
print("Variable (age):", age)
print("Constant-style name (MAX_VALUE):", MAX_VALUE)
print("Name with underscore (student_id):", student_id)
print("Class object name:", s.name)

# Call the function
display_message()